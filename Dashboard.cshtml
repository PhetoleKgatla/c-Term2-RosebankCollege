@model IEnumerable<RaceDay.MVC.Models.EventModel>

@{
    ViewData["Title"] = "Participant Dashboard";

    // Retrieve all events from the API
    var upcomingEvents = Model?
        .OrderBy(e => e.Date)
        .ToList()
        ?? new List<RaceDay.MVC.Models.EventModel>();

    var eventTypes = upcomingEvents
        .Where(e => !string.IsNullOrWhiteSpace(e.EventType))
        .Select(e => e.EventType)
        .Distinct()
        .ToList();
}


<div class="container mt-4 mb-5">

    <!-- Welcome Section -->
    <div class="p-4 mb-4 rounded-3 shadow-sm"
         style="background: linear-gradient(120deg, #0d6efd, #073b78); color: white;">

        <h1 class="fw-bold">Welcome to RaceDay!</h1>

        <p class="mb-1">
            Welcome back, @ViewBag.participantEmail.
        </p>

        <p class="mb-0">
            Discover upcoming races, explore events and get ready
            to achieve your next personal best.
        </p>
    </div>

    <!-- Dashboard Summary -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Upcoming Events</h6>
                    <h2 class="text-primary fw-bold">
                        @upcomingEvents.Count
                    </h2>
                    <p class="mb-0">Available races</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Account Role</h6>
                    <h2 class="text-success fw-bold">Participant</h2>
                    <p class="mb-0">Your RaceDay account</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">RaceDay</h6>
                    <h2 class="text-primary fw-bold">Ready?</h2>
                    <p class="mb-0">Your next race starts here.</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming Events Section -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <div>
                    <h3 class="fw-bold mb-1">Upcoming Events</h3>
                    <p class="text-muted mb-0">
                        Explore available races and find your next challenge.
                    </p>
                </div>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary mt-2">
                    View All Events
                </a>

            </div>

        </div>

        <div class="card-body">

            <!-- Event Filters -->
            <div class="row g-3 mb-4">

                <div class="col-md-8">
                    <label for="eventSearch" class="form-label">
                        Search Events
                    </label>

                    <input type="text"
                           id="eventSearch"
                           class="form-control"
                           placeholder="Search by event name or location..." />
                </div>

                <div class="col-md-4">
                    <label for="eventTypeFilter" class="form-label">
                        Filter by Event Type
                    </label>

                    <select id="eventTypeFilter" class="form-select">
                        <option value="">All Event Types</option>

                        @foreach (var type in eventTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

            </div>

            @if (!upcomingEvents.Any())
            {
                <div class="alert alert-info">
                    There are currently no upcoming events.
                    Please check again later.
                </div>
            }
            else
            {
                <div class="row g-3" id="eventContainer">

                    @foreach (var item in upcomingEvents)
                    {
                        <div class="col-md-6 col-lg-4 event-card"
                             data-name="@item.EventName.ToLowerInvariant()"
                             data-location="@item.Location.ToLowerInvariant()"
                             data-type="@item.EventType">

                            <div class="card h-100 border shadow-sm">

                                <div class="card-body d-flex flex-column">

                                    <span class="badge bg-primary mb-3 align-self-start">
                                        @item.EventType
                                    </span>

                                    <h5 class="card-title fw-bold">
                                        @item.EventName
                                    </h5>

                                    <p class="text-muted mb-2">
                                        <strong>Date:</strong>
                                        @item.Date
                                    </p>

                                    <p class="text-muted mb-2">
                                        <strong>Location:</strong>
                                        @item.Location
                                    </p>

                                    <p class="text-muted mb-3">
                                        <strong>Distance:</strong>
                                        @item.Distance
                                    </p>

                                    <p class="card-text flex-grow-1">
                                        @item.Description
                                    </p>

                                    <a asp-controller="Participant"
                                       asp-action="Details"
                                       asp-route-id="@item.EventID"
                                       class="btn btn-outline-primary mt-2">
                                        View Event Details
                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div id="noMatchingEvents"
                     class="alert alert-warning mt-3"
                     style="display: none;">
                    No events match your search.
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {

    <script>
        const searchInput = document.getElementById("eventSearch");
        const typeFilter = document.getElementById("eventTypeFilter");
        const eventCards = document.querySelectorAll(".event-card");
        const noMatchingEvents = document.getElementById("noMatchingEvents");

        function filterEvents() {

            const searchValue = searchInput.value.toLowerCase();
            const selectedType = typeFilter.value.toLowerCase();

            let visibleEvents = 0;

            eventCards.forEach(card => {

                const name = card.dataset.name;
                const location = card.dataset.location;
                const type = card.dataset.type.toLowerCase();

                const matchesSearch =
                    name.includes(searchValue) ||
                    location.includes(searchValue);

                const matchesType =
                    selectedType === "" || type === selectedType;

                if (matchesSearch && matchesType) {

                    card.style.display = "";

                    visibleEvents++;

                } else {

                    card.style.display = "none";

                }

            });

            if (noMatchingEvents) {
                noMatchingEvents.style.display =
                    visibleEvents === 0 ? "block" : "none";
            }
        }

        searchInput.addEventListener("input", filterEvents);

        typeFilter.addEventListener("change", filterEvents);
    </script>
}
