
@model IEnumerable<RaceDay.MVC.Models.EventModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary font-weight-bold">Organiser Dashboard</h1>
        <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow border-0 bg-light p-3">
                <h5>Total Created Events</h5>
                <h3 class="text-primary">@Model?.Count()</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow border-0 bg-light p-3">
                <h5>Upcoming Events</h5>
                <h3 class="text-success">@Model?.Count(e => e.Date >= DateTime.Now)</h3>
            </div>
        </div>
    </div>

    <!-- Events Management Table -->
    <div class="card shadow border-0">
        <div class="card-body">
            <h3 class="card-title mb-3">Event Management</h3>
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No events created yet. Click "Create New Event" to get started.</p>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distance</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.EventName</td>
                                <td>@ev.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@ev.Location</td>
                                <td>@ev.Distance</td>
                                <td>@ev.EventType</td>
                                <td>
                                    <a asp-action="EditEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="ManageCategories" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-secondary">Categories</a>
                                    <a asp-action="Enrolments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-info">Enrolments</a>
                                    <a asp-action="DeleteEvent" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>