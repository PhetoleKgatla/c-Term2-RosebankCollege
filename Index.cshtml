@model IEnumerable<RaceDay.MVC.Models.EventModel>

@{
    ViewData["Title"] = "Events Catalog";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Upcoming RaceDay Events</h2>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning" role="alert">
            No events are currently available from the API. Please ensure your API project is running.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary fw-bold">@item.EventName</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-geo-alt"></i> @item.Location &bull; <i class="bi bi-calendar"></i> @item.Date
                            </h6>
                            <p class="card-text flex-grow-1">@item.Description</p>
                            <div class="mb-3">
                                <span class="badge bg-info text-dark">Type: @item.EventType</span>
                                <span class="badge bg-secondary">Distance: @item.Distance</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>